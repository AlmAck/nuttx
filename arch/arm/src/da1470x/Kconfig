# Peripheral support

config DA1470_HAVE_UART
	bool
	default n

config DA1470_HAVE_UART2
	bool
	default n

config DA1470_HAVE_UART3
	bool
	default n

# Peripheral Selection

config DA1470_UART
	bool
	default n

menu "da1470 Peripheral Selection"

config DA1470_UART
	bool "UART0"
	default n
	select UART_SERIALDRIVER
	select DA1470_UART

config DA1470_UART1
	bool "UART1"
	default n
	depends on DA1470_HAVE_UART1
	select UART1_SERIALDRIVER
	select DA1470_UART

config DA1470_UART2
	bool "UART2"
	default n
	depends on DA1470_HAVE_UART1
	select UART2_SERIALDRIVER
	select DA1470_UART

endmenu # da1470 Peripheral Selection


