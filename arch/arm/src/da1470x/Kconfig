menu "High Frequency Clock (HFCLK) Configuration"

config DA1470_HFCLK
    bool "Enable High Frequency Clock (HFCLK) Initialization"
    default y
    ---help---
      Enable initialization of the High Frequency Clock (HFCLK) in the DA1470 series.
      This option initializes the HFCLK crystal oscillator, switching to the external
      32 MHz oscillator if available and configured. When enabled, the system will
      wait until the external oscillator is ready before continuing.

endmenu



menu "Low Power Clock (LFCLK) Configuration"

config DA1470_USE_LFCLK
    bool "Enable Low Power Clock (LFCLK)"
    default y
    ---help---
      Enable the Low Power Clock (LFCLK) in the DA1470 series. This will allow
      the system to select and configure one of the available low-power clock
      sources: RCLP, RCX, XTAL32K, or External Clock.

if DA1470_USE_LFCLK

choice
    prompt "Select LFCLK Source"
    default CLOCK_LPCLKSRC_SRC_RCLP
    ---help---
      Select the clock source to use as the low power clock (LFCLK). The options
      include RCLP, RCX, XTAL32K, or an external clock source.

config CLOCK_LPCLKSRC_SRC_RCLP
    bool "RCLP (Internal Low Power Clock)"
    ---help---
      Select RCLP (Internal Low Power Clock) as the LFCLK source.

config CLOCK_LPCLKSRC_SRC_RCX
    bool "RCX (Internal 32kHz Clock)"
    ---help---
      Select RCX (Internal 32kHz Clock) as the LFCLK source.

config CLOCK_LPCLKSRC_SRC_XTAL32K
    bool "XTAL32K (External 32kHz Crystal)"
    ---help---
      Select XTAL32K (External 32kHz Crystal) as the LFCLK source.

config CLOCK_LPCLKSRC_SRC_EXTERNAL
    bool "External Clock"
    ---help---
      Select an external clock source as the LFCLK. This option assumes the clock
      is configured and supplied externally.

endchoice

endif # DA1470_USE_LFCLK

endmenu
