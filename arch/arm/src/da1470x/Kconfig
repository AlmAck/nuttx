# Peripheral support

# call UART0 as convenience, even if is originally called UART from renesas
config DA1470_HAVE_UART0
	bool
	default n

config DA1470_HAVE_UART1
	bool
	default n

config DA1470_HAVE_UART2
	bool
	default n

# Peripheral Selection

config DA1470_UART
	bool
	default n

menu "DA1470 Peripheral Selection"

config DA1470_UART0
	bool "UART0"
	default n
	select UART0_SERIALDRIVER
	select DA1470_UART

config DA1470_UART1
	bool "UART1"
	default n
	depends on DA1470_HAVE_UART1
	select UART1_SERIALDRIVER
	select DA1470_UART

config DA1470_UART2
	bool "UART2"
	default n
	depends on DA1470_HAVE_UART2
	select UART2_SERIALDRIVER
	select DA1470_UART

endmenu # da1470 Peripheral Selection


