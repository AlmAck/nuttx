comment "DA1470 Configuration Options"

# DA1470 Families

choice
	prompt "DA1470 Chip Selection"
	default ARCH_CHIP_DA14706
	depends on ARCH_CHIP_DA1470X

config ARCH_CHIP_DA14706
	bool "DA14706"
	select DA1470_CPUAPP_MEM_FLASH_1024
	select DA1470_CPUAPP_MEM_RAM_512
	#select DA1470_CPUSNC_MEM_FLASH_256
	#select DA1470_CPUSNC_MEM_RAM_64

endchoice # DA1470 Chip Selection

config DA1470_APPCORE
	bool
	default n
	#select ARM_HAVE_DSP
	#select ARCH_HAVE_FPU
	select DA1470_HAVE_UART0

config DA1470_SNCCORE
	bool
	default n

choice
	prompt "DA1470 Core Selection"
	default ARCH_CHIP_DA1470_CPUAPP
	depends on ARCH_CHIP_DA14706

config ARCH_CHIP_DA1470_CPUAPP
	bool "DA1470 App core"
	select DA1470_APPCORE

config ARCH_CHIP_DA1470_CPUSNC
	bool "DA1470 Sensor Node Controller"
	select DA1470_SNCCORE

endchoice # Core Selection

# RAM size for the app core

config DA1470_CPUAPP_MEM_RAM_512
	bool
	default n

config DA1470_CPUAPP_MEM_RAM_SIZE
	hex
	default 0x080000 if DA1470_CPUAPP_MEM_RAM_512

