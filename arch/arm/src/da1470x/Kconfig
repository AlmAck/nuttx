#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "DA1470X Configuration Options"

choice
	prompt "DA1470X Chip Selection"
	default ARCH_CHIP_DA14706
	depends on ARCH_CHIP_DA1470X

config ARCH_CHIP_DA14706
	bool "DA14706"
	select DA1470X_CPUAPP_MEM_RAM_1536
	select DA1470X_CPUAPP_MEM_FLASH_8192

endchoice # DA1470X Chip Selection

config DA1470X_APPCORE
	bool
	default n
	select DA1470X_HAVE_UART0
	select DA1470X_HAVE_UART1
	select DA1470X_HAVE_UART2
	select DA1470X_HAVE_SPI0
	select DA1470X_HAVE_SPI1
	select DA1470X_HAVE_SPI2
	select DA1470X_HAVE_I2C0
	select DA1470X_HAVE_I2C1
	select DA1470X_HAVE_I2C2

choice
	prompt "DA1470X Core Selection"
	default ARCH_CHIP_DA1470X_CPUAPP
	depends on ARCH_CHIP_DA14706

config ARCH_CHIP_DA1470X_CPUAPP
	bool "DA1470X application core (Cortex-M33)"
	select DA1470X_APPCORE

endchoice # DA1470X Core Selection

config DA1470X_CPUAPP_MEM_RAM_1536
	bool
	default n

config DA1470X_CPUAPP_MEM_RAM_SIZE
	hex
	default 0x180000 if DA1470X_CPUAPP_MEM_RAM_1536

config DA1470X_CPUAPP_MEM_FLASH_8192
	bool
	default n

config DA1470X_CPUAPP_MEM_FLASH_SIZE
	hex
	default 0x800000 if DA1470X_CPUAPP_MEM_FLASH_8192

# Peripheral availability (hidden)

config DA1470X_HAVE_UART0
	bool
	default n

config DA1470X_HAVE_UART1
	bool
	default n

config DA1470X_HAVE_UART2
	bool
	default n

config DA1470X_HAVE_SPI0
	bool
	default n

config DA1470X_HAVE_SPI1
	bool
	default n

config DA1470X_HAVE_SPI2
	bool
	default n

config DA1470X_HAVE_I2C0
	bool
	default n

config DA1470X_HAVE_I2C1
	bool
	default n

config DA1470X_HAVE_I2C2
	bool
	default n

config DA1470X_UART
	bool
	default n

config DA1470X_SPI
	bool
	default n

config DA1470X_I2C
	bool
	default n

menu "DA1470X Peripheral Selection"

config DA1470X_UART0
	bool "UART0 (datasheet UART)"
	default n
	depends on DA1470X_HAVE_UART0
	select UART0_SERIALDRIVER
	select DA1470X_UART

config DA1470X_UART1
	bool "UART1 (datasheet UART2, RTS/CTS capable)"
	default n
	depends on DA1470X_HAVE_UART1
	select UART1_SERIALDRIVER
	select DA1470X_UART

config DA1470X_UART2
	bool "UART2 (datasheet UART3, RTS/CTS capable)"
	default n
	depends on DA1470X_HAVE_UART2
	select UART2_SERIALDRIVER
	select DA1470X_UART

config DA1470X_SPI0
	bool "SPI0 (datasheet SPI)"
	default n
	depends on DA1470X_HAVE_SPI0
	select DA1470X_SPI

config DA1470X_SPI1
	bool "SPI1 (datasheet SPI2)"
	default n
	depends on DA1470X_HAVE_SPI1
	select DA1470X_SPI

config DA1470X_SPI2
	bool "SPI2 (datasheet SPI3, PD_SYS)"
	default n
	depends on DA1470X_HAVE_SPI2
	select DA1470X_SPI

config DA1470X_I2C0
	bool "I2C0 (datasheet I2C)"
	default n
	depends on DA1470X_HAVE_I2C0
	select DA1470X_I2C

config DA1470X_I2C1
	bool "I2C1 (datasheet I2C2)"
	default n
	depends on DA1470X_HAVE_I2C1
	select DA1470X_I2C

config DA1470X_I2C2
	bool "I2C2 (datasheet I2C3)"
	default n
	depends on DA1470X_HAVE_I2C2
	select DA1470X_I2C

config DA1470X_DMA
	bool "DMA controller"
	default n
	---help---
		Enable the 8-channel general purpose DMA controller driver.

config DA1470X_GPIO_IRQ
	bool "GPIO interrupts (via wake-up controller)"
	default n
	---help---
		Route GPIO edge events through the WKUP block to the three
		per-port NVIC interrupts and dispatch them per pin.

config DA1470X_RTC
	bool "RTC"
	default n
	select RTC
	select RTC_DATETIME
	select RTC_ALARM
	select RTC_DRIVER
	---help---
		Real-time clock with calendar and alarm, exposed as /dev/rtc0.

config DA1470X_PDC
	bool "Power Domain Controller (PDC)"
	default n
	---help---
		Driver for the PDC lookup table that wakes the M33 from sleep on
		RTC, timer, GPIO or radio events.

config DA1470X_PM
	bool "Power management (CONFIG_PM lower half)"
	default n
	depends on DA1470X_PDC
	select PM
	---help---
		Implement the NuttX PM states on the DA1470x: IDLE = WFI,
		STANDBY = clock-gated sleep with all RAM retained and PD_SYS
		kept alive.

config DA1470X_PM_EXTENDED_SLEEP
	bool "Extended sleep (PD_SYS off) for PM_SLEEP"
	default n
	depends on DA1470X_PM
	---help---
		Save the core context and let the PMU switch PD_SYS off for the
		PM_SLEEP state, resuming through the reset vector.  Experimental.

config DA1470X_OQSPI_MTD
	bool "OQSPI flash controller MTD driver"
	default n
	select MTD
	select MTD_BYTE_WRITE
	select MTD_PARTITION
	---help---
		Expose the boot flash behind the OQSPI controller as an MTD
		device.  Program and erase run from RAM with interrupts masked
		because the code executes in place from the same flash.

config DA1470X_OQSPI_MTD_OFFSET
	hex "Offset of the MTD partition in flash"
	default 0x400000
	depends on DA1470X_OQSPI_MTD

config DA1470X_OQSPI_MTD_SIZE
	hex "Size of the MTD partition"
	default 0x400000
	depends on DA1470X_OQSPI_MTD

config DA1470X_LCDC
	bool "LCD controller (framebuffer)"
	default n
	select VIDEO_FB
	select FB_UPDATE
	---help---
		Display controller driver exposed through /dev/fb0.

config DA1470X_LCDC_TE
	bool "Synchronise frame updates to the panel tearing-effect line"
	default n
	depends on DA1470X_LCDC

config DA1470X_LCDC_NBUFFERS
	int "Number of frame buffers"
	default 2
	range 1 2
	depends on DA1470X_LCDC
	---help---
		With two buffers the framebuffer reports twice the visible
		height; clients draw into either half and pan to it, which
		lets a renderer prepare one frame while the other is shown.

config DA1470X_LCDC_ASYNC
	bool "Send frames from a driver thread"
	default y
	depends on DA1470X_LCDC && DA1470X_LCDC_NBUFFERS = 2
	---help---
		An update taken from another frame buffer than the previous
		one returns at once and the frame goes out from a driver
		thread, so a double-buffering client (LVGL) draws its next
		frame during the transfer and the tearing-effect wait.
		Updates of the same buffer stay synchronous.

config DA1470X_LCDC_ASYNC_PRIORITY
	int "Priority of the frame transfer thread"
	default 180
	depends on DA1470X_LCDC_ASYNC


config DA1470X_GPU
	bool "GPU (D/AVE 2D) driver"
	default n
	---help---
		Native register-level driver for the 2D graphics accelerator,
		exposed as /dev/gpu0.

config DA1470X_BLE
	bool "Bluetooth LE (CMAC controller + HCI transport)"
	default n
	depends on DA1470X_PDC && (DA1470X_CLOCK_XTAL32M_SRC || DA1470X_CLOCK_PLL160_SRC)
	select ALLOW_BSD_COMPONENTS
	select NET
	select NETDEVICES
	select NETDEV_LATEINIT
	select WIRELESS
	select WIRELESS_BLUETOOTH
	select WIRELESS_BLUETOOTH_HOST
	select NET_BLUETOOTH
	select SCHED_HPWORK
	---help---
		Load the CMAC controller firmware and register a NuttX HCI
		driver over the CPUAPP/CMAC mailbox.

config DA1470X_CMAC_FW_PATH
	string "Path of the CMAC firmware binary (relative to the NuttX tree)"
	default "../Renesas_SDK-10.2.6.49/cmac_fw.bin"
	depends on DA1470X_BLE
	---help---
		Firmware area extracted from the SDK's libble_stack_da1470x.a
		with tools/da1470x_cmac_fw.sh.  The controller only sleeps with
		XTAL32K as low-power clock; with RCLP it is kept awake.

config DA1470X_PWMLED
	bool "PWM LED driver block"
	default n
	select PWM
	select ARCH_HAVE_PWM_MULTICHAN
	---help---
		Expose the three constant-current LED outputs of the PWMLED
		block as a NuttX PWM lower half (channels 1..3 with
		CONFIG_PWM_MULTICHAN, shared period 31 Hz..7.8 kHz).

config DA1470X_WDOG_FREEZE
	bool "Freeze the system watchdog at boot"
	default y
	---help---
		The SYS watchdog is running out of reset and would reset the
		chip after about 10 seconds.  Freeze it until a watchdog driver
		takes over.

config DA1470X_DMA_SMOKETEST
	bool "Run a memory-to-memory DMA smoke test at bring-up"
	default n
	depends on DA1470X_DMA

endmenu # DA1470X Peripheral Selection

menu "High Frequency Clock (HFCLK) Configuration"

choice
	prompt "Select HFCLK Source"
	default DA1470X_CLOCK_XTAL32M_SRC

config DA1470X_CLOCK_XTAL32M_SRC
	bool "XTAL32M (external 32 MHz crystal)"
	---help---
		Start the 32 MHz crystal oscillator and run the system clock
		from it.  Required for the radio and for accurate peripheral
		timing.

config DA1470X_CLOCK_PLL160_SRC
	bool "PLL at 160 MHz (from the XTAL32M crystal)"
	---help---
		Start the crystal and the system PLL and run the core at
		160 MHz.  The flash controller runs at 80 MHz.  The
		peripheral clock stays at 32 MHz.

config DA1470X_CLOCK_RCHS_SRC
	bool "RCHS (internal high-speed RC oscillator)"

endchoice

if DA1470X_CLOCK_RCHS_SRC

choice
	prompt "RCHS frequency"
	default DA1470X_CLOCK_HFCLK_SRC_RCHS_32

config DA1470X_CLOCK_HFCLK_SRC_RCHS_32
	bool "32 MHz"

config DA1470X_CLOCK_HFCLK_SRC_RCHS_64
	bool "64 MHz"

config DA1470X_CLOCK_HFCLK_SRC_RCHS_96
	bool "96 MHz"

endchoice

endif # DA1470X_CLOCK_RCHS_SRC

endmenu

menu "Low Power Clock (LFCLK) Configuration"

config DA1470X_USE_LFCLK
	bool "Enable Low Power Clock (LFCLK)"
	default y

if DA1470X_USE_LFCLK

choice
	prompt "Select LFCLK Source"
	default DA1470X_CLOCK_LPCLK_SRC_RCLP

config DA1470X_CLOCK_LPCLK_SRC_RCLP
	bool "RCLP (internal 32 kHz RC, inaccurate)"

config DA1470X_CLOCK_LPCLK_SRC_RCX
	bool "RCX (internal 32 kHz RC, calibrated)"

config DA1470X_CLOCK_LPCLK_SRC_XTAL32K
	bool "XTAL32K (external 32.768 kHz crystal)"

config DA1470X_CLOCK_LPCLK_SRC_EXTERNAL
	bool "External clock on a GPIO"

endchoice

endif # DA1470X_USE_LFCLK

endmenu
