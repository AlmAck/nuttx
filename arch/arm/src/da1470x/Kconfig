if ARCH_CHIP_DA1470X
comment "DA1470X Configuration Options"

choice
	prompt "DA1470X Chip Selection"
	default ARCH_CHIP_DA1470X
	depends on ARCH_CHIP_DA1470X

config ARCH_CHIP_da1470x
	bool "DA1470X"
	select da1470x_DA1470X
	select da1470x_FLASH_CONFIG_I
	select da1470x_IO_CONFIG_A
	---help---
		da1470x Cortex M33F, 2048 Kb FLASH, 1536 Kb SRAM

endchoice # da1470x Chip Selection


#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "DA1470X Configuration Options"

# DA1470 Families

choice
	prompt "DA1470X Chip Selection"
	default ARCH_CHIP_DA1470

config ARCH_CHIP_DA1470
	bool "DA1470"
	select DA1470_CPUAPP_MEM_FLASH_1024
	select DA1470_CPUAPP_MEM_RAM_320
	select DA1470_CPUSNC_MEM_FLASH_256
	select DA1470_CPUSNC_MEM_RAM_64

endchoice # NRF53 Chip Selection

config DA1470_APPCORE
	bool
	default n
	select ARM_HAVE_DSP
	select ARCH_HAVE_FPU
	select DA1470_HAVE_UART

config DA1470_SNCCORE
	bool
	default n

choice
	prompt "da1470 Core Selection"
	default ARCH_CHIP_DA1470_CPUAPP
	depends on ARCH_CHIP_DA1470

config ARCH_CHIP_DA1470_CPUAPP
	bool "da1470 App core"
	select DA1470_APPCORE

config ARCH_CHIP_DA1470_CPUSNC
	bool "da1470 Sensor Node Controller"
	select DA1470_SNCCORE

endchoice # Core Selection

