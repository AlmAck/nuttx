include armv8-m/Make.defs

CHIP_ASRCS  =
ifeq ($(CONFIG_DA1470X_PM_EXTENDED_SLEEP),y)
CHIP_ASRCS += da1470x_deepsleep.S
endif
CHIP_CSRCS  = da1470x_allocateheap.c da1470x_clockconfig.c da1470x_gpio.c
CHIP_CSRCS += da1470x_irq.c da1470x_lowputc.c da1470x_start.c
CHIP_CSRCS += da1470x_pmu.c

ifeq ($(CONFIG_DA1470X_TICKLESS),y)
CHIP_CSRCS += da1470x_tickless.c
else
CHIP_CSRCS += da1470x_systick.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += da1470x_idle.c
endif

ifeq ($(CONFIG_DA1470X_UART),y)
CHIP_CSRCS += da1470x_serial.c
endif

ifeq ($(CONFIG_DA1470X_DMA),y)
CHIP_CSRCS += da1470x_dma.c
endif

ifeq ($(CONFIG_DA1470X_SPI),y)
CHIP_CSRCS += da1470x_spi.c
endif

ifeq ($(CONFIG_DA1470X_I2C),y)
CHIP_CSRCS += da1470x_i2c.c
endif

ifeq ($(CONFIG_DA1470X_RTC),y)
CHIP_CSRCS += da1470x_rtc.c da1470x_rtc_lowerhalf.c
endif

ifeq ($(CONFIG_DA1470X_PDC),y)
CHIP_CSRCS += da1470x_pdc.c
endif

ifeq ($(CONFIG_PM),y)
CHIP_CSRCS += da1470x_pm.c da1470x_pminitialize.c
endif

ifeq ($(CONFIG_DA1470X_OQSPI_MTD),y)
CHIP_CSRCS += da1470x_oqspi.c
endif

ifeq ($(CONFIG_DA1470X_LCDC),y)
CHIP_CSRCS += da1470x_lcdc.c
endif

ifeq ($(CONFIG_DA1470X_GPU),y)
CHIP_CSRCS += da1470x_gpu.c
endif

ifeq ($(CONFIG_DA1470X_TCS),y)
CHIP_CSRCS += da1470x_otp.c da1470x_tcs.c
endif

ifeq ($(CONFIG_DA1470X_BLE),y)
CHIP_CSRCS += da1470x_cmac.c da1470x_bt.c
endif

ifeq ($(CONFIG_DA1470X_AUDIO),y)
CHIP_CSRCS += da1470x_audio.c
endif

ifeq ($(CONFIG_DA1470X_VAD),y)
CHIP_CSRCS += da1470x_vad.c
endif

ifeq ($(CONFIG_DA1470X_SNC),y)
CHIP_CSRCS += da1470x_snc.c
endif

ifeq ($(CONFIG_DA1470X_PWMLED),y)
CHIP_CSRCS += da1470x_pwmled.c
endif
