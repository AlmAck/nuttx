# The start-up, "head", file.  Only common vectors are support so there
# isn't one.

HEAD_ASRC =

# Common ARM and Cortex-M4 files (copied from da1470x/Make.defs)

include armv8-m/Make.defs

# Required da1470x files

CHIP_ASRCS  =
CHIP_CSRCS  = da1470x_allocateheap.c da1470x_clk.c da1470x_clockconfig.c
CHIP_CSRCS += da1470x_gpio.c da1470x_irq.c da1470x_lowputc.c
CHIP_CSRCS += da1470x_start.c da1470x_systick.c da1470x_serial.c


#ifeq ($(CONFIG_DA1470_UART),y)
#CHIP_CSRCS += da1470x_serial.c
#endif

#ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
#CHIP_CSRCS += da1470x_idle.c
#endif
#
#ifeq ($(CONFIG_TIMER),y)
#CHIP_CSRCS += da1470x_tim_lowerhalf.c
#endif
#
#ifeq ($(CONFIG_BUILD_PROTECTED),y)
#CHIP_CSRCS += da1470x_userspace.c da1470x_mpuinit.c
#endif
#
#ifeq ($(CONFIG_DEBUG_FEATURES),y)
#CHIP_CSRCS += da1470x_dumpgpio.c
#endif
#
## Required chip type specific files
#
#ifeq ($(CONFIG_USBDEV),y)
#CHIP_CSRCS += da1470x_otgdev.c
#endif
