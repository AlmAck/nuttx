include $(TOPDIR)/Make.defs

CSRCS = da1470x_boot.c da1470x_bringup.c

ifeq ($(CONFIG_BOARDCTL),y)
CSRCS += da1470x_appinit.c
endif

ifeq ($(CONFIG_ARCH_LEDS),y)
CSRCS += da1470x_autoleds.c
else
CSRCS += da1470x_userleds.c
endif

ifeq ($(CONFIG_DEV_GPIO),y)
CSRCS += da1470x_gpio.c
endif

ifeq ($(CONFIG_DA1470X_SPI),y)
CSRCS += da1470x_spi.c
endif

ifeq ($(CONFIG_DA1470X_I2C),y)
CSRCS += da1470x_i2c.c
endif

ifeq ($(CONFIG_DA14706_LCD_E120A390QSR),y)
CSRCS += da1470x_e120a390qsr.c
endif

ifeq ($(CONFIG_DA14706_LCD_LPM012M134B),y)
CSRCS += da1470x_lpm012m134b.c
endif

ifeq ($(CONFIG_DA14706_TOUCH_ZT2628),y)
CSRCS += da1470x_zt2628.c
endif

ifeq ($(CONFIG_DA1470X_PWMLED),y)
CSRCS += da1470x_pwmled.c
endif

ifeq ($(CONFIG_DA1470X_BLE),y)
ASRCS += da1470x_cmac_fw.S
AFLAGS += -DDA1470X_CMAC_FW_PATH=\"$(TOPDIR)/$(CONFIG_DA1470X_CMAC_FW_PATH)\"
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
