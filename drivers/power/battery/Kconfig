#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menu "Battery Management Support"

config BATTERY_CHARGER
	bool "Battery Charger support"
	default n

config BQ2425X
	bool "BQ2425X Battery charger support"
	default n
	select I2C
	select I2C_BQ2425X
	depends on BATTERY_CHARGER
	depends on ALLOW_BSD_COMPONENTS
	---help---
		The BQ24250/BQ24251 are battery charger for lithium-ion batteries.

config I2C_BQ2425X
	bool

config BQ2429X
	bool "BQ2429X Battery charger support"
	default n
	select I2C
	select I2C_BQ2429X
	depends on BATTERY_CHARGER
	---help---
		The BQ24296/BQ24297/BQ24296M are battery charger for lithium-ion batteries.

config I2C_BQ2429X
	bool

if BQ2429X

config DEBUG_BQ2429X
	bool "BQ2429X Debug Features"
	default n
	---help---
		Enable BQ2429X battery management debug features.

endif # BQ2429X

config AXP202
	bool "AXP202 Battery charger support"
	default n
	select I2C
	select I2C_AXP202
	depends on BATTERY_CHARGER
	---help---
		axp202 are battery charger for lithium-ion batteries.

config I2C_AXP202
	bool

config AXP202_DC2_VOLTAGE
	int "AXP202 DC2 output voltage"
	default 0
	depends on AXP202
	---help---
		AXP202 DC2 output voltage. 0 is disable, enable range: [700, 2275] mV.

config AXP202_DC3_VOLTAGE
	int "AXP202 DC3 output voltage"
	default 3300
	depends on AXP202
	---help---
		AXP202 DC3 output voltage. 0 is disable, enable range: [700, 3500] mV.

config AXP202_LDO2_VOLTAGE
	int "AXP202 LDO2 output voltage"
	default 0
	depends on AXP202
	---help---
		AXP202 LDO2 output voltage. 0 is disable, enable range: [1800, 3300] mV.

config AXP202_LDO3_VOLTAGE
	int "AXP202 LDO3 output voltage"
	default 0
	depends on AXP202
	---help---
		Enable LDO3 output voltage. 0 is disable, enable range: [700, 2275] mV.

config AXP202_LDO4_VOLTAGE
	int "AXP202 LDO4 output voltage"
	default 0
	depends on AXP202
	---help---
		Enable LDO4 output voltage. 0 is disable, other value:
			1250 1300 1400 1500 1600 1700 1800 1900
			2000 2500 2700 2800 3000 3100 3200 3300 mV.

config MCP73871
	bool "Microchip MCP73871 Battery charger support"
	default n
	depends on BATTERY_CHARGER
	---help---
		A simple driver to report MCP73871 status.

config BATTERY_GAUGE
	bool "Battery Fuel Gauge support"
	default n

config MAX1704X
	bool "MAX1704X Battery fuel gauge support"
	default n
	select I2C
	select I2C_MAX1704X
	depends on BATTERY_GAUGE
	---help---
		The MAX17040/MAX17041 are ultra-compact, low-cost, host-side fuel-gauge
		systems for lithium-ion (Li+) batteries in handheld and portable equipment.
		The MAX17040 is configured to operate with a single lithium cell and the
		MAX17041 is configured for a dual-cell 2S pack.

config BATTERY_SOC_ESTIMATOR
	bool "Voltage-based state-of-charge estimator"
	default n
	---help---
		A piecewise-linear discharge curve with optional IR-drop
		compensation, for PMICs that measure battery voltage but have no
		coulomb-counting fuel gauge (nPM1300), and as a fallback for
		gauges that report nonsense until they converge.

if BATTERY_SOC_ESTIMATOR

choice
	prompt "Cell model"
	default BATTERY_SOC_MODEL_LIPO_42
	---help---
		Which open-circuit-voltage curve the estimate is looked up on.
		This must match the cell chemistry: a 4.35 V cell read against
		the 4.2 V curve sits at 100% for the first third of its
		discharge, and a LiFePO4 cell read against either reads
		permanently flat.

		Drivers that know their own cell can override this per device
		with battery_soc_from_loaded_model().

config BATTERY_SOC_MODEL_LIPO_42
	bool "LiPo / LiCoO2, 4.2 V full"
	---help---
		The usual single-cell wearable battery.

config BATTERY_SOC_MODEL_LIPO_HV
	bool "High-voltage LiPo, 4.35 V full"
	---help---
		Same chemistry with the top of the curve stretched. Pair this
		with a charger termination voltage above 4.2 V or most of the
		extra range is never reached.

config BATTERY_SOC_MODEL_LIFEPO4
	bool "LiFePO4, 3.65 V full"
	---help---
		Very flat: roughly 80% of the capacity sits inside a 60 mV
		band, so a voltage-only estimate means little except near the
		two ends. Selected because the alternative - reading it against
		a LiCoO2 curve - is worse, not because it is good.

endchoice

endif # BATTERY_SOC_ESTIMATOR

config BATTERY_NPM1300
	bool "Nordic nPM1300 PMIC (charger + battery gauge)"
	default n
	select I2C
	select BATTERY_SOC_ESTIMATOR
	depends on BATTERY_GAUGE
	---help---
		Nordic nPM1300 PMIC at the fixed I2C address 0x6b: configures the
		Li-ion charger and registers a battery_gauge device.

		The part has no fuel gauge in hardware (Nordic's coulomb counter
		ships as a library with nRF Connect SDK), so BATIOC_CAPACITY is
		answered from the voltage curve in battery_soc.c, compensated with
		the measured battery current. It is an estimate, not a gauge.

if BATTERY_NPM1300

config NPM1300_I2C_FREQUENCY
	int "nPM1300 I2C frequency"
	default 400000

config NPM1300_VTERM_MV
	int "Charge termination voltage in mV"
	default 4200
	---help---
		Representable values are 3500-3650 and 4000-4450 in 50 mV steps.
		The range between 3650 and 4000 mV cannot be encoded.

config NPM1300_ICHG_MA
	int "Charge current in mA"
	default 100
	---help---
		32 to 800 mA in 2 mA steps.

config NPM1300_HAVE_NTC
	bool "Board has a battery NTC thermistor"
	default y
	---help---
		Say n when no thermistor is fitted. The charger reads the missing
		NTC as out of range and refuses to charge unless it is disabled.

config NPM1300_ESR_MOHM
	int "Cell internal resistance in mOhm (0 = default)"
	default 0
	---help---
		Used to back out the IR drop before the voltage is looked up on the
		discharge curve. 0 uses BATTERY_SOC_DEFAULT_ESR_MOHM.

config NPM1300_BUCK1_MV
	int "BUCK1 output voltage in mV (0 = leave alone)"
	default 0
	---help---
		1000 to 3300 in 100 mV steps, or 0 to leave the rail exactly as
		it is.

		Out of reset a buck follows its external VSET1 resistor pins and
		ignores the voltage register entirely. A non-zero value here
		takes the rail over in software, programs it and enables it.

		0 is the default on purpose: these rails usually power the host
		that is doing the programming, so changing one is a decision
		about the board, not a tuning knob. Check what the rail feeds
		before setting it.

config NPM1300_BUCK2_MV
	int "BUCK2 output voltage in mV (0 = leave alone)"
	default 0
	---help---
		As NPM1300_BUCK1_MV, for the second rail.

config NPM1300_WATCHDOG
	bool "Register the PMIC watchdog"
	default n
	depends on WATCHDOG
	---help---
		Expose the PMIC's system timer in watchdog mode as a NuttX
		watchdog device.

		This is a second watchdog, independent of the SoC's own: it
		lives across the I2C bus, so it still fires when the CPU and its
		on-die watchdog are wedged together, and in reset mode it cycles
		the rails rather than just the core.

		Registering does not start it. Nothing feeds a watchdog until
		something opens the device and issues WDIOC_START, which is
		deliberate - see the mode option below.

if NPM1300_WATCHDOG

config NPM1300_WATCHDOG_DEVPATH
	string "Watchdog device path"
	default "/dev/watchdog1"
	---help---
		Keep this off /dev/watchdog0 if the SoC watchdog is also
		registered, which is the normal arrangement.

config NPM1300_WATCHDOG_TIMEOUT_MS
	int "Default watchdog window in ms"
	default 60000
	---help---
		16 ms resolution, up to about 74 hours. WDIOC_SETTIMEOUT
		overrides it at runtime.

choice
	prompt "Watchdog expiry action"
	default NPM1300_WATCHDOG_MODE_WARN

config NPM1300_WATCHDOG_MODE_WARN
	bool "Warn (pulse the interrupt line)"
	---help---
		Safe default: expiry is reported and nothing else happens. Use
		this until the feeding path is known to work.

config NPM1300_WATCHDOG_MODE_RESET
	bool "Reset (power-cycle the system)"
	---help---
		Expiry cycles the PMIC rails, taking the whole board down and
		back up. Only choose this once something reliably feeds the
		watchdog, or the board will power-cycle on its own every
		NPM1300_WATCHDOG_TIMEOUT_MS.

endchoice

endif # NPM1300_WATCHDOG

endif # BATTERY_NPM1300

config I2C_MAX1704X
	bool

config BQ27426
	bool "BQ27426 Battery fuel gauge support"
	default n
	select I2C
	depends on BATTERY_GAUGE
	---help---
		The bq27426 battery fuel gauge accurately predicts the battery capacity and other
		operational characteristics of a single, Li-based, rechargeable cell.
		It can be interrogated by a system processor to provide cell information,
		such as state-of-charge (SOC).

config BATTERY_MONITOR
	bool "Battery Monitor/Management support"
	default n

config BQ769X0
	bool "BQ769X0 Battery monitor support"
	default n
	select I2C
	select I2C_BQ769X0
	depends on BATTERY_MONITOR
	---help---
		The BQ76920/BQ76930/BQ76940 provide monitoring, balancing, and
		protection features for up to 15 cells in series.

config I2C_BQ769X0
	bool

if BQ769X0
config BQ769X0_USE_INTERNAL_TS
	bool "Use internal temperature sensor on BQ769X0"
	default n
endif

config GOLDFISH_BATTERY
	bool "Goldfish Battery charger support"
	default n
	depends on BATTERY_GAUGE
	---help---
		The GOLDFISH_BATTERY are battery charger for emulate batteries.

config BATTERY_FAKE_GAUGE
	bool "Battery fake gauge support"
	default n
	depends on BATTERY_GAUGE
	---help---
		The BATTERY FAKE are battery charger for emulate gauge.

endmenu
